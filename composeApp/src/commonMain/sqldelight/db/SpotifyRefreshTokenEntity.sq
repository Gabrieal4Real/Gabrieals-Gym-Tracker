CREATE TABLE spotifyRefreshTokenEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    accessToken TEXT,
    expiresIn INTEGER,
    tokenType TEXT,
    refreshToken TEXT
);

selectSpotifyRefreshToken:
SELECT * FROM spotifyRefreshTokenEntity
WHERE id = 1;

insertOrReplaceSpotifyRefreshToken:
INSERT OR REPLACE INTO spotifyRefreshTokenEntity (
    id, accessToken, expiresIn, tokenType, refreshToken
) VALUES (
    1, ?, ?, ?, ?
);

deleteSpotifyRefreshToken:
DELETE FROM spotifyRefreshTokenEntity
WHERE id = 1;